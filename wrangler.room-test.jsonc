{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhuyin-island-room-local-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-19",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "RoomObject" },
    { "name": "ROOM_LIMITS", "class_name": "RoomRateLimiter" }
  ] },
  "migrations": [{ "tag": "room-v1", "new_sqlite_classes": ["RoomObject", "RoomRateLimiter"] }]
}
